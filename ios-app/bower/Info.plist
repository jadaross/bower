<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Custom keys cannot travel via
	     INFOPLIST_KEY_* build settings — Xcode only forwards keys it knows,
	     and drops anything else without warning. -->
	<key>BowerAPIBaseURL</key>
	<string>$(BOWER_API_BASE_URL)</string>
	<key>BowerSupabaseURL</key>
	<string>$(BOWER_SUPABASE_URL)</string>
	<key>BowerSupabaseAnonKey</key>
	<string>$(BOWER_SUPABASE_ANON_KEY)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIAppFonts</key>
	<array>
		<string>InstrumentSerif-Regular.ttf</string>
		<string>InstrumentSerif-Italic.ttf</string>
		<string>Geist.ttf</string>
		<string>GeistMono.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
</dict>
</plist>
